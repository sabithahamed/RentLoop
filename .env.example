# Copy to .env and fill in. .env is gitignored — never commit a real key.
#
# Get a key at https://aistudio.google.com → "Get API key". The free tier covers
# the Flash models, which is all the agent needs.
#
# WARNING: anything prefixed EXPO_PUBLIC_ is compiled into the app bundle and can
# be extracted by anyone who has the app. That is an accepted prototype tradeoff,
# not a production one — rotate this key after the demo, and move it behind a
# Supabase Edge Function before any real release.

EXPO_PUBLIC_GEMINI_API_KEY=

# Optional. Defaults to gemini-flash-latest.
#
# Note that a model appearing in the API's model list does NOT mean your key can
# call it — Google keeps older models listed but closed to new keys. Run
# `node scripts/check-gemini.mjs` to find one that actually works.
EXPO_PUBLIC_GEMINI_MODEL=
